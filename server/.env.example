# ------------------------------------------------------------------
# ExamSlot backend environment configuration
# Copy this file to `server/.env` and fill in real values.
# Never commit your real `.env`.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB. Local development default is a standalone mongod.
# For production use a MongoDB Atlas SRV string (replica set -> transactions supported).
MONGODB_URI=mongodb://127.0.0.1:27017/examslot

# JWT signing secret. Use a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=replace-with-a-long-random-secret

# Access token lifetime (e.g. 2h, 1d).
JWT_EXPIRES_IN=2h

# Frontend origin used for CORS + links inside emails.
# Comma-separated list of origins is allowed for CORS, e.g.
#   CLIENT_URL=https://myapp.netlify.app,http://localhost:5173
# (the FIRST origin is used to build links inside emails).
CLIENT_URL=http://localhost:5173

# University timezone used for slot display and validation (IANA name).
UNIVERSITY_TIMEZONE=Asia/Karachi

# Default exam duration (minutes) applied when an exam slot has no end time.
DEFAULT_EXAM_DURATION_MINUTES=180

# ---- Resend (transactional email). Optional in development. ----
# Leave RESEND_API_KEY empty to run with email delivery disabled.
# The API reports an explicit "delivery unavailable" status instead of pretending to send.
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account.
RESEND_FROM_EMAIL=ExamSlot <no-reply@your-verified-domain.com>

# ---- Demo administrator (used by the seed script) ----
ADMIN_NAME=ExamSlot Administrator
ADMIN_EMAIL=admin@examslot.local
ADMIN_PASSWORD=Admin@ExamSlot123

# Demo student password created by the seed script.
DEMO_STUDENT_PASSWORD=Student@ExamSlot123
